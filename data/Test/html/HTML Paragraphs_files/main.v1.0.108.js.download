,codeeditor:'<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',webtemplates:'<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>'};// Build grid cards
topics.forEach(function(t){var card=document.createElement("a");card.className="tutnav-card";card.setAttribute("data-name",t.name);card.setAttribute("data-category",t.cat);// TODO: Revert billing bandaid — was: card.setAttribute("href", t.url || "/"); if (t.target) card.setAttribute("target", t.target);
bindRedirectLink(card,t.url||"/",'tutorials.grid.'+t.name);var iconHtml=window.iconSvgs[t.name]||'<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none" stroke="#555" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>';card.innerHTML='<div class="tutnav-icon-wrap">'+iconHtml+'</div><h4 class="tutnav-card-title">'+t.label+"</h4>"+(t.desc?'<p class="tutnav-card-desc">'+t.desc+"</p>":"");grid.appendChild(card);});function showDetail(t){gridView.style.display="none";detailView.style.display="block";detailView.classList.add("tutnav-detail-active");// Copy icon from card
var card=grid.querySelector('.tutnav-card[data-name="'+t.name+'"]');if(card){var iconSvg=card.querySelector(".tutnav-icon-wrap").innerHTML;detailIcon.innerHTML=iconSvg;}detailTitle.textContent=t.label;detailOptions.innerHTML="";// Tutorial card
var tutCard=document.createElement("a");tutCard.className="tutnav-opt-card";// TODO: Revert billing bandaid — was: tutCard.href = t.url;
bindRedirectLink(tutCard,t.url,'tutorials.detail.tutorial.'+t.name);tutCard.innerHTML='<div class="tutnav-opt-card-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#04AA6D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></div><div class="tutnav-opt-card-text"><h4 class="tutnav-opt-card-title">Tutorial</h4><p class="tutnav-opt-card-desc">Learn '+t.label+"</p></div>";detailOptions.appendChild(tutCard);// Reference card (if available)
if(t.ref){var refCard=document.createElement("a");refCard.className="tutnav-opt-card";// TODO: Revert billing bandaid — was: refCard.href = t.ref;
bindRedirectLink(refCard,t.ref,'tutorials.detail.reference.'+t.name);refCard.innerHTML='<div class="tutnav-opt-card-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#04AA6D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg></div><div class="tutnav-opt-card-text"><h4 class="tutnav-opt-card-title">Reference</h4><p class="tutnav-opt-card-desc">'+t.label+" Reference</p></div>";detailOptions.appendChild(refCard);}}backBtn.addEventListener("click",function(){detailView.style.display="none";detailView.classList.remove("tutnav-detail-active");gridView.style.display="";});// Filter
var filterClear=document.querySelector("#nav_tutorials .tutnav-filter-clear");filterInput.addEventListener("input",function(){var val=this.value.toLowerCase();var cards=grid.querySelectorAll(".tutnav-card");for(var i=0;i<cards.length;i++){var name=cards[i].getAttribute("data-name")||"";var title=cards[i].querySelector(".tutnav-card-title");var label=title?title.textContent.toLowerCase():"";cards[i].style.display=name.indexOf(val)>-1||label.indexOf(val)>-1?"":"none";}});if(filterClear){filterClear.addEventListener("click",function(){filterInput.value="";var cards=grid.querySelectorAll(".tutnav-card");for(var i=0;i<cards.length;i++){cards[i].style.display="";}});}// Clone icons from Exercises when modal opens
