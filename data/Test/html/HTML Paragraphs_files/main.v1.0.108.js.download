// Was: dropdown links navigated via plain href, target="_blank", window.location.href, and window.open — no TopNavBar.handleRedirect.
var redirectContextPrefix='TopNavBar.initDropdownNavs';function escapeForInlineJsString(str){return String(str).replace(/\\/g,'\\\\').replace(/'/g,"\\'");}function bindRedirectLink(link,url,contextSuffix,options){options=options||{};if(!url||url==='#'){link.href='#';return link;}link.href='javascript:void(0)';link.removeAttribute('target');var context=redirectContextPrefix+'.'+contextSuffix;link.addEventListener('click',function(event){event.preventDefault();if(options.stopPropagation){event.stopPropagation();}TopNavBar.handleRedirect(context,url);});return link;}function redirectOnclick(url,contextSuffix,options){options=options||{};if(!url||url==='#'){return'';}var context=redirectContextPrefix+'.'+contextSuffix;var handler='';if(options.stopPropagation){handler+='event.stopPropagation();';}if(options.preventDefault!==false){handler+='event.preventDefault();';}handler+='TopNavBar.handleRedirect(\''+context+'\',\''+escapeForInlineJsString(url)+'\');';return handler;}function redirectAnchorHtml(url,className,contextSuffix,innerHtml,extraAttrs){if(!url||url==='#'){var disabledClassAttr=className?' class="'+className+'"':'';return'<a'+disabledClassAttr+(extraAttrs?' '+extraAttrs:'')+' href="#">'+innerHtml+'</a>';}var classAttr=className?' class="'+className+'"':'';var attrs='href="javascript:void(0)" onclick="'+redirectOnclick(url,contextSuffix)+'"';if(extraAttrs){attrs+=' '+extraAttrs;}return'<a'+classAttr+' '+attrs+'>'+innerHtml+'</a>';}function redirectDivOnclick(url,contextSuffix){return'onclick="'+redirectOnclick(url,contextSuffix,{preventDefault:false})+'"';}// tutorials
