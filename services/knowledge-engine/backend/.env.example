# CIAL Knowledge OS API development environment

# Deprecated compatibility input: the API logs and ignores this value.
CIAL_AUTO_INDEX_ON_STARTUP=false
CIAL_FORCE_REBUILD_ON_STARTUP=false
CIAL_STARTUP_INDEX_TIMEOUT_SECONDS=0
# Optional explicit override. If unset, the backend uses data/config/application.json,
# then deprecated CIAL_DATA_DIR, then the development fallback data/files.
# CIAL_CORPUS_ROOT=D:\CIAL\KnowledgeRepository
CIAL_APP_DATA_DIR=data
CIAL_OUTPUTS_DIR=outputs
CIAL_MODELS_DIR=models
DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@localhost:5432/cial_knowledge_os_dev
# Comma-separated explicit frontend origins. Required when cookies are used.
CIAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000
CIAL_AUTH_COOKIE_NAME=cial_auth_session
CIAL_AUTH_SESSION_TTL_HOURS=168
CIAL_AUTH_COOKIE_SECURE=false
CIAL_AUTH_COOKIE_SAMESITE=lax
CIAL_CORPUS_SYNC_ON_STARTUP=false
CIAL_CORPUS_WATCH=true
CIAL_CORPUS_WATCH_DEBOUNCE_MS=750
CIAL_CORPUS_FILE_STABILITY_INTERVAL_MS=500
CIAL_CORPUS_FILE_STABILITY_CHECKS=3
CIAL_CORPUS_RECONCILE_INTERVAL_SECONDS=300
CIAL_CORPUS_HASH=sha256
CIAL_METADATA_BATCH_SIZE=500

CIAL_QDRANT_MODE=server
CIAL_QDRANT_URL=http://localhost:6335
CIAL_QDRANT_API_KEY=
CIAL_QDRANT_BATCH_SIZE=32
CIAL_QDRANT_UPSERT_WAIT=true
CIAL_QDRANT_COLLECTION=cial_phase4
QDRANT_TIMEOUT_SECONDS=30
QDRANT_RETRY_ATTEMPTS=3
QDRANT_RETRY_BACKOFF_SECONDS=2
QDRANT_HEALTH_TIMEOUT_SECONDS=5
QDRANT_QUERY_TIMEOUT_SECONDS=30
CIAL_EVIDENCE_SELECTION_TIMEOUT_SECONDS=5
QDRANT_UPSERT_TIMEOUT_SECONDS=60
QDRANT_DELETE_TIMEOUT_SECONDS=60
QDRANT_COLLECTION_TIMEOUT_SECONDS=120

CIAL_INDEXER_ENABLED=true
CIAL_INDEXER_WORKER_ID=
CIAL_INDEXER_POLL_SECONDS=1
CIAL_INDEXER_LEASE_SECONDS=120
CIAL_INDEXER_HEARTBEAT_SECONDS=15
CIAL_INDEXER_HEARTBEAT_STALE_SECONDS=45
CIAL_INDEXER_MAX_ATTEMPTS=5
CIAL_INDEXER_RETRY_BACKOFF_SECONDS=5
CIAL_INDEXER_MIN_EXTRACTION_WORKERS=1
CIAL_INDEXER_MAX_EXTRACTION_WORKERS=16
CIAL_INDEXER_EXTRACTION_WORKERS=8
CIAL_INDEXER_OCR_WORKERS=2
CIAL_INDEXER_PREPARED_QUEUE_SIZE=8
CIAL_INDEXER_EMBED_QUEUE_SIZE=4096
CIAL_INDEXER_WRITE_QUEUE_SIZE=16
CIAL_INDEXER_EMBED_BATCH_SIZE=64
CIAL_INDEXER_EMBED_MIN_BATCH_SIZE=1
CIAL_INDEXER_EMBED_MAX_BATCH_SIZE=256
CIAL_INDEXER_EMBED_GROWTH_LATENCY_TOLERANCE=1.15
CIAL_INDEXER_EMBED_VRAM_TARGET_RATIO=0.70
CIAL_INDEXER_EMBED_MAX_BATCH_TOKENS=32768
CIAL_INDEXER_EMBED_MAX_WAIT_MS=75
CIAL_INDEXER_QDRANT_BATCH_SIZE=256
CIAL_INDEXER_DEVICE=auto
CIAL_INDEXER_PRECISION=fp16
CIAL_INDEXER_GPU_POLICY=balanced
CIAL_INDEXER_GPU_COOPERATIVE_MODE=true
CIAL_INDEXER_RELEASE_GPU_WHEN_IDLE=true
CIAL_INDEXER_GPU_IDLE_RELEASE_SECONDS=30
CIAL_GPU_PRIORITY_POLL_SECONDS=0.1
CIAL_BM25_REFRESH_DEBOUNCE_SECONDS=2

CIAL_OLLAMA_MODEL_NAME=gemma3:12b
CIAL_OLLAMA_KEEP_ALIVE=30m
CIAL_OLLAMA_GPU_PRIORITY_ENABLED=true
CIAL_OLLAMA_NUM_GPU=-1
# Measured RTX 5070 Ti policy: explicit CPU preserves Ollama VRAM headroom.
CIAL_QUERY_EMBEDDING_DEVICE=cpu
CIAL_EMBEDDING_MODEL_NAME=BAAI/bge-m3
CIAL_RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# Auto resolves once. Use cuda:0 only on a validated single-GPU deployment.
CIAL_RERANKER_DEVICE=auto
CIAL_RERANKER_BATCH_SIZE=16
CIAL_LOCAL_FILES_ONLY=false
CIAL_MAX_ANSWER_WORDS=1200
CIAL_GENERATION_RETRIES=2
CIAL_RETRY_COOLDOWN_SECONDS=20
CIAL_CHAT_DEBUG=false
CIAL_CHAT_REQUEST_TIMEOUT_SECONDS=150
CIAL_CHAT_MULTI_REQUEST_ENABLED=true
CIAL_CHAT_EXECUTOR_WORKERS=8
CIAL_CHAT_MAX_ACTIVE_GLOBAL=8
CIAL_CHAT_MAX_ACTIVE_PER_USER=2
CIAL_CHAT_MAX_QUEUED_GLOBAL=64
CIAL_CHAT_MAX_QUEUED_PER_USER=8
CIAL_CHAT_QUERY_EMBEDDING_CONCURRENCY=1
CIAL_CHAT_RETRIEVAL_CONCURRENCY=4
CIAL_CHAT_RERANK_CONCURRENCY=1
CIAL_CHAT_GENERATION_CONCURRENCY=1
CIAL_CHAT_QUEUE_WAIT_TIMEOUT_SECONDS=120
CIAL_CHAT_EVENT_QUEUE_SIZE=256
CIAL_CHAT_TOKEN_FLUSH_MS=40
CIAL_CHAT_TOKEN_FLUSH_CHARS=256
CIAL_CHAT_FAIR_SCHEDULING=true

TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
TESSERACT_CMD=
# Personal originals must remain outside the enterprise corpus root.
CIAL_WORKSPACE_ROOT=data/user-workspaces
# Zero disables quota enforcement; otherwise provide bytes.
CIAL_WORKSPACE_QUOTA_BYTES=0

# Optional Windows Mobile Hotspot edge. Internal services stay loopback-only.
CIAL_LAN_ACCESS_ENABLED=false
CIAL_LAN_MODE=hotspot
CIAL_LAN_HOSTNAME=cial-knowledge-os
CIAL_LAN_DOMAIN=cial-knowledge-os.local
# Explicit values take precedence over heuristics and must resolve to one Up
# adapter/private IPv4 pair. Keep auto unless the operator reviewed the adapter.
CIAL_LAN_BIND_INTERFACE=auto
CIAL_LAN_BIND_IP=auto
CIAL_LAN_HTTP_PORT=80
CIAL_LAN_HTTPS_ENABLED=false
CIAL_LAN_HTTPS_PORT=443
CIAL_LAN_ALLOW_IP_FALLBACK=true
CIAL_LAN_MDNS_ENABLED=true
CIAL_LAN_GATEWAY=caddy
CIAL_CADDY_PATH=
CIAL_LAN_GATEWAY_DATA_DIR=outputs/lan-server/caddy
CIAL_LAN_FIREWALL_MANAGED=true
CIAL_LAN_FIREWALL_REMOTE_SCOPE=hotspot_subnet
CIAL_LAN_QR_ENABLED=true
CIAL_LAN_KEEP_AWAKE=true
CIAL_LAN_ADAPTER_RECHECK_SECONDS=5
CIAL_LAN_STARTUP_TIMEOUT_SECONDS=30
CIAL_LAN_SHUTDOWN_TIMEOUT_SECONDS=10
