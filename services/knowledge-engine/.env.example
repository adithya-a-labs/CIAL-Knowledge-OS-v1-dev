# CIAL Knowledge OS backend environment

# Offline model/runtime flags
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1

# Optional explicit OCR binary path. Leave blank when tesseract is on PATH.
TESSERACT_CMD=

# Local model defaults documented by the backend configuration.
OLLAMA_MODEL_NAME=gemma3:12b
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Qdrant local backend
QDRANT_MODE=embedded
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Development FastAPI adapter
API_HOST=127.0.0.1
API_PORT=8000
# Personal originals must remain outside the enterprise corpus root.
CIAL_WORKSPACE_ROOT=data/user-workspaces
CIAL_WORKSPACE_QUOTA_BYTES=0
