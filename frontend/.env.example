# CIAL Knowledge OS - Environment Variables
# Copy this file to .env and fill in values for your environment

# API Configuration
VITE_API_BASE_URL=http://localhost:8000

# Authentication
# The current development auth flow uses the backend HttpOnly cookie session.
# Keep VITE_API_BASE_URL pointed at the same backend origin that sets the cookie.
VITE_AUTH_CLIENT_ID=
VITE_AUTH_TENANT_ID=
VITE_AUTH_REDIRECT_URI=

# AI Integration (future)
VITE_AI_API_ENDPOINT=
VITE_AI_MODEL_VERSION=

# Feature Flags
VITE_ENABLE_REAL_AI=false
VITE_ENABLE_AUTH=true

